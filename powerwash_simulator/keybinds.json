{
  "name": "PowerWash Simulator",
  "window_titles": ["powerwash simulator"],
  "priority": ["wash", "sprint", "movement"],
  "bindings": [
    {"id": "movement", "keys": ["w", "a", "s", "d"], "mode": "continuous", "enabled": true, "devices": ["all"]},
    {"id": "sprint", "keys": ["shift"], "mode": "continuous", "enabled": true, "devices": ["all"]},
    {"id": "wash", "keys": ["mouse_left"], "mode": "continuous", "enabled": true, "devices": ["all"]},
    {"id": "jump", "keys": ["space"], "mode": "pulse", "enabled": true, "devices": ["all"]},
    {"id": "stance_cycle", "keys": ["ctrl"], "mode": "pulse", "enabled": true, "devices": ["all"]},
    {"id": "interact", "keys": ["e"], "mode": "pulse", "enabled": true, "devices": ["all"]},
    {"id": "nozzle_cycle", "keys": ["mouse_middle", "scroll"], "mode": "pulse", "enabled": true, "devices": ["all"]}
  ]
}
