{
  "name": "Waterpark Simulator",
  "window_titles": ["waterpark simulator"],
  "priority": ["sprint", "movement"],
  "bindings": [
    {"id": "movement", "keys": ["w", "a", "s", "d"], "mode": "continuous", "enabled": true, "devices": ["all"]},
    {"id": "sprint", "keys": ["shift"], "mode": "continuous", "enabled": true, "devices": ["all"]},
    {"id": "jump", "keys": ["space"], "mode": "pulse", "enabled": true, "devices": ["all"]},
    {"id": "interact", "keys": ["e"], "mode": "pulse", "enabled": true, "devices": ["all"]},
    {"id": "place", "keys": ["mouse_left"], "mode": "pulse", "enabled": true, "devices": ["all"]},
    {"id": "rotate", "keys": ["mouse_right"], "mode": "pulse", "enabled": true, "devices": ["all"]},
    {"id": "build_menu", "keys": ["tab"], "mode": "pulse", "enabled": true, "devices": ["all"]},
    {
      "id": "switch_item",
      "keys": ["1", "2", "3", "4", "5", "6", "7", "8", "9", "scroll"],
      "mode": "pulse",
      "enabled": true,
      "devices": ["all"]
    }
  ]
}
