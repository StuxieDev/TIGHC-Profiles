{
  "name": "Supermarket Simulator",
  "window_titles": ["supermarket simulator"],
  "priority": ["sprint", "movement"],
  "bindings": [
    {"id": "movement", "keys": ["w", "a", "s", "d"], "mode": "continuous", "enabled": true, "devices": ["all"]},
    {"id": "sprint", "keys": ["shift"], "mode": "continuous", "enabled": true, "devices": ["all"]},
    {"id": "jump", "keys": ["space"], "mode": "pulse", "enabled": true, "devices": ["all"]},
    {"id": "interact", "keys": ["mouse_left"], "mode": "pulse", "enabled": true, "devices": ["all"]},
    {"id": "open_box", "keys": ["e"], "mode": "pulse", "enabled": true, "devices": ["all"]},
    {"id": "rotate", "keys": ["r"], "mode": "pulse", "enabled": true, "devices": ["all"]}
  ]
}
